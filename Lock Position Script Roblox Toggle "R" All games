-- LocalScript placed inside StarterPlayer > StarterPlayerScripts
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

-- Keep track of character respawns
player.CharacterAdded:Connect(function(newCharacter)
	character = newCharacter
	humanoid = character:WaitForChild("Humanoid")
	rootPart = character:WaitForChild("HumanoidRootPart")
end)

local isLocked = false
local TOGGLE_KEY = Enum.KeyCode.R

local function toggleLock()
	-- Safety check in case character parts are missing
	if not rootPart or not humanoid then return end
	
	isLocked = not isLocked
	
	if isLocked then
		-- Lock the player
		rootPart.Anchored = true
		humanoid.PlatformStand = true -- Prevents animations and physics forces from overriding the lock
	else
		-- Unlock the player
		rootPart.Anchored = false
		humanoid.PlatformStand = false
	end
end

-- Listen for the "R" key press
UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
	-- gameProcessedEvent is true if the player is typing in chat or a menu, we don't want to trigger it then
	if gameProcessedEvent then return end
	
	if input.KeyCode == TOGGLE_KEY then
		toggleLock()
	end
end)
